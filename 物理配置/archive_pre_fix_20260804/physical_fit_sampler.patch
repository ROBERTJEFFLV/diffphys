+def _stratified_unit(batch_size: int, device: torch.device, dtype: torch.dtype, bins: int, offset: int = 0) -> torch.Tensor:
+    """One-dimensional stratified U[0,1] samples.
+
+    For batch_size=256 and bins=4, different offsets give balanced coverage of
+    mass, thrust, inertia, and delay bins inside each batch instead of relying on
+    pure Monte-Carlo luck.
+    """
+    index = torch.arange(batch_size, device=device)
+    bin_id = ((index // max(1, int(offset))) % int(bins)).to(dtype=dtype)
+    return (bin_id + torch.rand((batch_size,), device=device, dtype=dtype)) / float(bins)
+
+
+def _range_from_unit(unit: torch.Tensor, low: torch.Tensor | float, high: torch.Tensor | float) -> torch.Tensor:
+    return low + unit * (high - low)
+
