# Production identifier pretraining: frozen Q2 execution, simulator capability
# targets, and only the deployable identifier/adapter/mean-head parameters.
--source-checkpoint {root}/reports/q_residual_h500_u2000_gpu2/seed_7/group_Q2/checkpoints/model_update_2000.pt
--output {work}/identifier_init.pt
--report {work}/identifier_pretrain_report.json
--causal-oracle-report {work}/causal_identifier_oracle.json
--probe-v4-report {root}/reports/probe_v4_formal.json
--device {device}
--seed 7
--scenarios 64
--horizon 125
--updates 5
--prefix 25
--lr 0.0003
--hidden-dim 64
--identifier-dim 64
--slow-cadence 25
--identification-publish-start 50
--motor-observer-bank-size 35
--motor-observer-mode fixed_multi_tau_v2
--motor-tau-grid-version 2
--burn-in-probe-amplitude 0.005
--allocator-solver box_qp
--allocator-rate-limit 50.0
