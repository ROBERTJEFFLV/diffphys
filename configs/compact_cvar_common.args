# Strictly paired P0-P4 training. One H500 episode contains two H250
# truncated-BPTT segments and one optimizer update. The retain bank is hard
# replay only; action-retain MSE and capability/response heads are disabled.
@configs/retain_tail_common.args
--lambda-motor-aux 0.03
--lambda-capability-aux 0.0
--lambda-response-aux 0.0
--w-retain 0.0
--q-position 0.20
--q-omega 0.20
--w-position-cvar 0.001
--w-omega-cvar 0.001
--final-tail-weight 1.0
--integral-limit 0.5
--integral-leak 0.0
