--mode train
--optimizer short-window
--device cuda
--dtype float32
--seed 7
--scenarios 64
--horizon 500
--window-steps 50
--critic-lr 0.001
--critic-epochs 1
--critic-batch-size 1024
--critic-dev-relative-tolerance 0.002
--lr 0.0003
--gradient-clip 10
--prediction-weight 0
--huber-delta 1
--tail-fraction 0.2
--checkpoint-every 1
--development-every 25
--maximum-adam-rejections 3
--contract-report runs/response_critic_v1/contract.json
--work-dir runs/response_critic_v1/seed7
