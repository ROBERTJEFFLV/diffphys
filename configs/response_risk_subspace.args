--mode profile
--optimizer short-window
--actor-proposal physics-subspace
--device cuda
--dtype float32
--seed 7
--scenarios 64
--horizon 500
--window-steps 50
--critic-return-scale-floor 0.001
--critic-direction-samples 4
--risk-relative-tolerance 0
--subspace-fd-relative-step 0.0001
--subspace-parameter-relative-step 0.0001
--subspace-fd-relative-tolerance 0.1
--subspace-fd-atol 0
--subspace-backtracks 4
--prediction-weight 0
--huber-delta 1
--checkpoint-every 1
--maximum-proposal-rejections 3
--work-dir runs/response_risk_subspace_v1/seed7
