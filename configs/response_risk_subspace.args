--mode profile
--optimizer short-window
--actor-proposal physics-subspace
--device cuda
--dtype float32
--seed 7
--scenarios 64
--horizon 500
--window-steps 50
--critic-direction-samples 4
--hard-risk-relative-tolerance 0.002
--hard-risk-absolute-tolerance 0.00000001
--subspace-parameter-relative-step 0.0001
--prediction-weight 0
--huber-delta 1
--checkpoint-every 1
--maximum-proposal-rejections 3
--work-dir runs/response_rollout_subspace_v1/seed7
