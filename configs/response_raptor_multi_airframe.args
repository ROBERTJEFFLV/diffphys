--mode train
--device cuda
--dtype float32
--seed 7
--scenarios 512
--train-sampling coverage128
--eval-scenarios 128
--horizon 500
--time-decay 1
--gradient-scale 0.1
--updates 50
--max-seconds 1800
--lr 3e-4
--gradient-clip 10
--development-every 50
--checkpoint-every 50
--huber-delta 1
--steady-weight 0
--dead-cost 3
--terminal-cost 200
--work-dir runs/pulsed_recovery/seed7
--group-max-groups 128
--group-min-scenarios 16
--group-clip-norm 1.0
--group-gradient-epsilon 1e-12
--group-vjp-chunk-size 16
--position-noise-std 0.001
--velocity-noise-std 0.002
--attitude-noise-std 0.001
--omega-noise-std 0.002
--velocity-delay-min 0.010
--velocity-delay-max 0.030
