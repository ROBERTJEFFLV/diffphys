--mode train
--scenario-mode raptor
--device cuda
--dtype float32
--seed 7
--scenarios 128
--eval-scenarios 128
--horizon 500
--backprop-mode full
--window-steps 50
--time-decay 1
--action-rate 0
--gradient-scale 0.1
--updates 50
--max-seconds 1800
--lr 3e-4
--gradient-clip 10
--agc 0
--development-every 50
--checkpoint-every 50
--huber-delta 1
--dead-cost 3
--terminal-cost 200
--work-dir runs/raptor_group_gradient/seed7
--group-balance
--group-max-groups 16
--group-min-scenarios 32
--group-gradient-epsilon 1e-12
--group-vjp-chunk-size 16
