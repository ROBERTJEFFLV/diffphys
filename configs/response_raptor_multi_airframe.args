--mode train
--device cuda
--dtype float32
--seed 7
--scenarios 128
--eval-scenarios 128
--horizon 500
--time-decay 1
--gradient-scale 0.1
--updates 50
--max-seconds 1800
--lr 3e-4
--gradient-clip 10
--development-every 50
--checkpoint-every 50
--huber-delta 1
--dead-cost 3
--terminal-cost 200
--work-dir runs/raptor_multi_airframe/seed7
--group-max-groups 16
--group-min-scenarios 32
--group-gradient-epsilon 1e-12
--group-vjp-chunk-size 16
--disturbance-budget 0.1
--disturbance-pool 1 1 1 1 1
