--mode train
--optimizer short-window
--device cuda
--dtype float32
--seed 7
--initialize-from runs/response_guarded_v1/seed7/best.training.pt
--horizon 500
--window-steps 50
--scenarios 64
--updates 5
--max-seconds 600
--minimum-updates 1
--checkpoint-every 1
--development-every 5
--maximum-adam-rejections 5
--critic-lr 0.001
--critic-epochs 1
--critic-batch-size 1024
--critic-dev-relative-tolerance 0.002
--lr 0.0003
--gradient-clip 10
--prediction-weight 0
--huber-delta 1
--tail-fraction 0.2
--work-dir runs/response_critic_825_precheck_v1/seed7
