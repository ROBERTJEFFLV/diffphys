--source-checkpoint reports/q_residual_h500_u2000_gpu2/seed_7/group_Q2/checkpoints/model_update_2000.pt
--output-dir runs/equilibrium_strict_h1000
--device cuda
--backend torch
--seed 7
--updates 20
--batch-size 8
--segment-steps 250
--segments 4
--energy-interval 25
--state-decay-base 1.0
--hidden-decay-base 1.0
--contraction-rate 0.25
--contraction-weight 1e-9
--prediction-weight 1e-4
--invariance-weight 1.0
--warmup-updates 8
--warmup-segments 1
--warmup-contraction-weight 2e-6
--warmup-prediction-weight 1.0
--warmup-state-decay-base 0.5
--warmup-hidden-decay-base 0.7
--lr 5e-6
--weight-decay 1e-6
--grad-clip 10
--grad-skip-threshold 1000
--checkpoint-every 10
