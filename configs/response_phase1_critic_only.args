--mode train
--optimizer task-adam
--scenario-mode fixed-airframe
--phase1-probes
--value-critic-only
--device cuda
--dtype float32
--seed 7
--scenarios 32
--horizon 500
--window-steps 50
--updates 1
--max-seconds 180
--lr 3e-4
--weight-decay 0
--gradient-clip 10
--critic-lr 1e-3
--critic-epochs 1
--critic-batch-size 1024
--value-target-tau 0.6
--value-gradient-clip 10
--value-derivative-holdout-scenes 16
--value-derivative-batch-size 32
--value-derivative-balance-mode minibatch
--value-warmup-max-fits 8
--value-warmup-max-seconds 120
--value-ready-min-cosine 0.9
--value-ready-max-relative-error 0.5
--development-every 5
--checkpoint-every 1
--prediction-weight 0
--huber-delta 1
--work-dir runs/phase1_critic_only/seed7
