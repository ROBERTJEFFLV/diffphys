--mode train
--optimizer adam
--device cuda
--dtype float32
--seed 7
--scenarios 64
--adam-train-batches 2
--horizon 250
--updates 150
--minimum-updates 100
--max-seconds 1800
--development-every 25
--checkpoint-every 10
--patience 12
--lr 0.0003
--prediction-weight 0.01
--adam-max-loss-ratio 2.0
--adam-max-omega-ratio 2.0
--adam-max-dev-loss-ratio 2.0
--maximum-adam-rejections 3
--contract-report runs/response_pooled_v1/contract.json
--work-dir runs/response_pooled_v1/seed7
