--mode profile
--scenario-mode raptor
--device cuda
--dtype float32
--seed 7
--scenarios 16
--eval-scenarios 16
--horizon 500
--backprop-mode full
--window-steps 50
--time-decay 1
--updates 1
--max-seconds 1800
--lr 3e-4
--gradient-clip 10
--gradient-scale 0.1
--agc 0
--group-balance
--group-max-groups 16
--group-min-scenarios 32
--group-scale-mode rms
--group-scale-floor 1
--work-dir runs/raptor_group_score_smoke/seed7
