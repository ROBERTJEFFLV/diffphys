# Q2 physical-step-budget time-horizon experiment. All control/loss/sampler
# settings are inherited unchanged; only integral input scale and episode
# horizon schedule vary in T0-T3.
@configs/q_residual_Q2.args
--init-checkpoint-path reports/q_residual_h500_u2000_gpu2/seed_7/group_Q2/checkpoints/model_update_2000.pt
--compensate-integral-input-scale-on-load
--seed 7
--device cuda
--sim-backend cuda
--batch-size 256
--horizon 250
--training-episode-steps 500
--persistent-episode-training
--update-timing episode-boundary
--optimizer-updates 0
--physical-step-budget 256000000
--checkpoint-physical-steps 32000000,64000000,96000000,128000000,192000000,256000000
--aux-weight-ramp-physical-steps 9600000
--checkpoint-updates ""
--save-every 0

