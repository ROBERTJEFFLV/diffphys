# Same 129-update/1,032,000-step paired screen; only scenario diversity changes.
--base-config configs/time_horizon_T2.args
--output-dir reports/multiple_shooting_diverse_128x8_screen
--eval-set reports/multiple_shooting_timed_value_screen/eval_set.pt
--device cuda
--batch-size 8
--training-scenarios 128
--cycles 8
--updates 129
--extra-batch-id 0
--seed 7
--schedule-seed 7011
--bootstrap-seed 7003
--bootstrap-replicates 10000
--arm-timeout-seconds 1200
