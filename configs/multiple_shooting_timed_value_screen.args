# Locked two-arm, paired, wall-clock-capped value screen.
--base-config configs/time_horizon_T2.args
--output-dir reports/multiple_shooting_timed_value_screen
--device cuda
--batch-size 8
--timing-updates 2
--paired-training-seconds 1080
--total-wall-seconds 1800
--eval-reserve-seconds 420
--ordinary-count 64
--hard-count 64
--hard-candidate-count 384
--bootstrap-replicates 10000
--seed 7
--ordinary-seed 7001
--hard-seed 7002
--bootstrap-seed 7003
