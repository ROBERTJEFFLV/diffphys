--source-checkpoint reports/q_residual_h500_u2000_gpu2/seed_7/group_Q2/checkpoints/model_update_2000.pt
--output-dir runs/equilibrium_strict_smoke
--device cpu
--backend torch
--seed 7
--updates 1
--batch-size 2
--segment-steps 4
--segments 2
--energy-interval 2
--state-decay-base 1.0
--hidden-decay-base 1.0
