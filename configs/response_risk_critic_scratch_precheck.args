--mode train
--optimizer short-window
--device cuda
--dtype float32
--seed 7
--scenarios 64
--horizon 500
--window-steps 50
--critic-lr 0.001
--critic-epochs 1
--critic-batch-size 1024
--critic-dev-relative-tolerance 0.002
--risk-position-limit 5
--risk-velocity-limit 5
--risk-omega-limit 10
--risk-saturation-limit 0.95
--risk-sharpness 10
--risk-weight 1
--critic-direction-samples 4
--critic-direction-epsilon 0.02
--critic-direction-weight 0.1
--critic-direction-temperature 0.1
--critic-direction-min-gap 0.000001
--lr 0.0003
--gradient-clip 10
--prediction-weight 0
--huber-delta 1
--tail-fraction 0.2
--checkpoint-every 1
--development-every 5
--maximum-adam-rejections 10
--contract-report runs/response_risk_critic_v1/contract.json
--work-dir runs/response_risk_critic_v1/seed7
--updates 10
--max-seconds 600
--minimum-updates 1
