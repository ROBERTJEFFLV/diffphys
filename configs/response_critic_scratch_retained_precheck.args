--mode train
--optimizer short-window
--device cuda
--dtype float32
--seed 7
--horizon 500
--window-steps 50
--scenarios 64
--updates 10
--max-seconds 600
--minimum-updates 1
--checkpoint-every 1
--development-every 5
--maximum-adam-rejections 10
--critic-lr 0.001
--critic-epochs 1
--critic-batch-size 1024
--critic-dev-relative-tolerance 0.002
--lr 0.0003
--gradient-clip 10
--prediction-weight 0
--huber-delta 1
--tail-fraction 0.2
--contract-report runs/response_critic_scratch_retained_v1/contract.json
--work-dir runs/response_critic_scratch_retained_v1/seed7
