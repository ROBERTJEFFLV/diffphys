# Paired H500 next-stage training. Two H250 truncated-BPTT segments form one
# complete training episode and exactly one accepted optimizer update.
--device cuda
--sim-backend cuda
--observation-mode legacy40
--horizon 250
--training-episode-steps 500
--persistent-episode-training
--update-timing episode-boundary
--batch-size 256
--optimizer-updates 2000
--encoder-dim 192
--hidden-dim 192
--encoder-depth 2
--lr 5e-6
--grad-clip 1.0
--grad-skip-threshold 0
--state-grad-decay 0.5
--hidden-grad-decay 0.7
--sample-dynamics
--sampled-dynamics-level broad
--broad-sampler physical
--init-checkpoint-path reports/mainline_h500_finetune_safe_5000_lr5e6/model_step_4000.pt
--baseline-checkpoint-path reports/mainline_h500_finetune_safe_5000_lr5e6/model_step_4000.pt
--retain-bank-path reports/next_stage_retain_bank/retain_bank.pt
--retain-fraction 0.25
--motor-aux-burn-in 15
--capability-aux-burn-in 35
--response-aux-burn-in 10
--response-dv-scale 0.1
--response-domega-scale 1.0
--aux-weight-ramp-updates 75
--tail-steps 50
--tail-window-steps 100
--lambda-tail-omega 1.0
--cvar-fraction 0.20
--steady-window-steps 100
--steady-required-fraction 0.95
--post-update-check off
--log-every 2
--training-diagnostics-every-updates 50
--save-every 250
--checkpoint-updates 250,500,750,1000,1500,2000
--sampler-audit-resets-only
--sampler-audit-hash-only
